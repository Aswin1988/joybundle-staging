# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Sheets is the V1 operational catalog. Keep these server-only.
NODE_ENV=development
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# Set true in CI/deployment validation to require Google Sheets credentials.
JOYBUNDLE_VALIDATE_ENV=false
JOYBUNDLE_VERSION=0.1.0

# Use fixture locally; use google-sheets in staging/production after credentials are configured.
CATALOG_DATA_SOURCE=fixture

# Optional legacy/future Supabase configuration. Not required by the V1 storefront.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
